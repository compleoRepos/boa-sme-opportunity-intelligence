# BOA SME Opportunity Intelligence — LOCAL DEVELOPMENT ONLY
# Copy to infrastructure/.env. Every value below is synthetic and MUST be replaced outside local development.
COMPOSE_PROJECT_NAME=boa-sme-opportunity-intelligence
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_PORT=3000
API_GATEWAY_PORT=8080
KEYCLOAK_PORT=8081
POSTGRES_DB=boa_sme
POSTGRES_ADMIN_USER=boa_admin
POSTGRES_ADMIN_PASSWORD=DevOnly-Postgres-ChangeMe!

CUSTOMER_DB_PASSWORD=DevOnly-CustomerDb-ChangeMe!
ACCOUNT_DB_PASSWORD=DevOnly-AccountDb-ChangeMe!
TRANSACTION_DB_PASSWORD=DevOnly-TransactionDb-ChangeMe!
INTEGRATION_DB_PASSWORD=DevOnly-IntegrationDb-ChangeMe!
ANALYTICS_DB_PASSWORD=DevOnly-AnalyticsDb-ChangeMe!
SIGNAL_DB_PASSWORD=DevOnly-SignalDb-ChangeMe!
OPPORTUNITY_DB_PASSWORD=DevOnly-OpportunityDb-ChangeMe!
PRODUCT_DB_PASSWORD=DevOnly-ProductDb-ChangeMe!
ACTION_DB_PASSWORD=DevOnly-ActionDb-ChangeMe!
RULE_MANAGEMENT_DB_PASSWORD=DevOnly-RuleManagementDb-ChangeMe!
FEATURE_STORE_DB_PASSWORD=DevOnly-FeatureStoreDb-ChangeMe!
ML_ENGINE_DB_PASSWORD=DevOnly-MlEngineDb-ChangeMe!
PORTFOLIO_DB_PASSWORD=DevOnly-PortfolioDb-ChangeMe!
NOTIFICATION_DB_PASSWORD=DevOnly-NotificationDb-ChangeMe!
KEYCLOAK_DB_PASSWORD=DevOnly-KeycloakDb-ChangeMe!

KEYCLOAK_ADMIN_USERNAME=boa-admin
KEYCLOAK_ADMIN_PASSWORD=DevOnly-KeycloakAdmin-ChangeMe!
RM_DEMO_PASSWORD=DevOnly-Rm1-ChangeMe!
BRANCH_MANAGER_DEMO_PASSWORD=DevOnly-Branch1-ChangeMe!
ADMIN_DEMO_PASSWORD=DevOnly-Admin1-ChangeMe!
ANALYST_DEMO_PASSWORD=DevOnly-Analyst1-ChangeMe!
BUSINESS_ANALYST_DEMO_PASSWORD=DevOnly-BusinessAnalyst1-ChangeMe!
RULE_APPROVER_DEMO_PASSWORD=DevOnly-RuleApprover1-ChangeMe!

API_GATEWAY_CLIENT_SECRET=DevOnly-GatewayClient-ChangeMe!
PIPELINE_CLIENT_SECRET=DevOnly-PipelineClient-ChangeMe!
CUSTOMER_CLIENT_SECRET=DevOnly-CustomerClient-ChangeMe!
ACCOUNT_CLIENT_SECRET=DevOnly-AccountClient-ChangeMe!
TRANSACTION_CLIENT_SECRET=DevOnly-TransactionClient-ChangeMe!
INTEGRATION_CLIENT_SECRET=DevOnly-IntegrationClient-ChangeMe!
ANALYTICS_CLIENT_SECRET=DevOnly-AnalyticsClient-ChangeMe!
SIGNAL_CLIENT_SECRET=DevOnly-SignalClient-ChangeMe!
OPPORTUNITY_CLIENT_SECRET=DevOnly-OpportunityClient-ChangeMe!
PRODUCT_CLIENT_SECRET=DevOnly-ProductClient-ChangeMe!
ACTION_CLIENT_SECRET=DevOnly-ActionClient-ChangeMe!
RULE_MANAGEMENT_CLIENT_SECRET=DevOnly-RuleManagementClient-ChangeMe!
RULE_ENGINE_CLIENT_SECRET=DevOnly-RuleEngineClient-ChangeMe!
RULE_SIMULATION_CLIENT_SECRET=DevOnly-RuleSimulationClient-ChangeMe!
FEATURE_STORE_CLIENT_SECRET=DevOnly-FeatureStoreClient-ChangeMe!
ML_ENGINE_CLIENT_SECRET=DevOnly-MlEngineClient-ChangeMe!
PORTFOLIO_CLIENT_SECRET=DevOnly-PortfolioClient-ChangeMe!
NOTIFICATION_CLIENT_SECRET=DevOnly-NotificationClient-ChangeMe!
# Obligatoire : générer au moins 32 octets aléatoires et stocker dans le coffre cible.
NOTIFICATION_SCOPE_SIGNING_SECRET=

OIDC_PUBLIC_ISSUER_URL=http://localhost:8081/realms/boa-sme-mvp
OIDC_INTERNAL_ISSUER_URL=http://keycloak:8080/realms/boa-sme-mvp
OIDC_AUDIENCE=boa-sme-api
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
DEMO_DATA_SEED=20260918
# Set to a collector URL only when an OpenTelemetry collector is deployed.
OTEL_EXPORTER_OTLP_ENDPOINT=

# SMTP local : Mailpit. En environnement bancaire, remplacer par un relais approuvé.
MAILPIT_WEB_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=boa-sme-opportunity@pilot.local
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_MESSAGE_ID_DOMAIN=pilot.local
SMTP_TIMEOUT_SECONDS=10
NOTIFICATION_POLL_INTERVAL_SECONDS=5

# Paramètres Vite intégrés au build frontend (aucun secret navigateur)
VITE_API_BASE_URL=
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=boa-sme-mvp
VITE_KEYCLOAK_CLIENT_ID=boa-sme-spa
VITE_AUTH_DISABLED=false
