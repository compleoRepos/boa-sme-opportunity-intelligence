# URL publique du Gateway. Vide en développement pour utiliser le proxy Vite.
VITE_API_BASE_URL=
VITE_GATEWAY_PROXY_TARGET=http://localhost:8080

# OIDC Authorization Code + PKCE (client public, aucun secret navigateur)
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=boa-sme-mvp
VITE_KEYCLOAK_CLIENT_ID=boa-sme-frontend

# Mettre true uniquement pour un serveur frontend local sans Keycloak.
VITE_AUTH_DISABLED=false
# Rôles de développement uniquement lorsque l’authentification est désactivée.
VITE_DEV_ROLES=RELATIONSHIP_MANAGER,ADMIN
